---
import { SignedIn, SignedOut, UserButton } from "@clerk/astro/components";
import "../styles/global.css";
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MangaTrack · Pastel Dreams</title>
  </head>
  <body class="bg-pastel-canvas text-[#1e1b4b] antialiased">
    <!-- Navbar -->
    <header class="w-full border-b border-pastel-accent/30 bg-white/70 backdrop-blur-md sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-xl bg-pastel-primary flex items-center justify-center text-white font-bold text-sm shadow-sm">
            M
          </div>
          <span class="font-bold text-lg tracking-tight">MangaTrack</span>
        </a>

        <div class="flex items-center gap-3">
          <SignedOut>
            <a
              href="/sign-in"
              class="px-4 py-2 text-sm font-medium rounded-xl bg-pastel-primary text-white hover:bg-pastel-secondary transition-colors shadow-sm"
            >
              Masuk / Daftar
            </a>
          </SignedOut>
          <SignedIn>
            <a
              href="/dashboard"
              class="px-4 py-2 text-sm font-medium rounded-xl bg-pastel-primary text-white hover:bg-pastel-secondary transition-colors shadow-sm"
            >
              Dashboard Library
            </a>
            <UserButton afterSignOutUrl="/" />
          </SignedIn>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-6xl mx-auto px-4 pt-16 pb-24">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Hero Text -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-pastel-surface/60 border border-pastel-accent/50 text-xs font-semibold uppercase tracking-wider text-pastel-primary">
            <span>✨</span> Pastel Dreams Edition
          </div>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight leading-tight">
            Pantau bacaan manga Anda dengan tenang dan rapi.
          </h1>

          <p class="text-base text-slate-600 leading-relaxed max-w-xl">
            Simpan judul favorit, catat chapter terakhir, dan sinkronisasi otomatis ke akun pribadi Anda.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <SignedIn>
              <a
                href="/dashboard"
                class="px-6 py-3 rounded-xl bg-pastel-primary text-white font-medium hover:bg-pastel-secondary transition-colors shadow-md shadow-pastel-primary/20"
              >
                Buka Library Saya
              </a>
            </SignedIn>
            <SignedOut>
              <a
                href="/sign-in"
                class="px-6 py-3 rounded-xl bg-pastel-primary text-white font-medium hover:bg-pastel-secondary transition-colors shadow-md shadow-pastel-primary/20"
              >
                Mulai Tracking
              </a>
            </SignedOut>
            <a
              href="#preview"
              class="px-6 py-3 rounded-xl bg-white/80 border border-pastel-accent/50 text-[#1e1b4b] font-medium hover:bg-white transition-colors"
            >
              Lihat Preview
            </a>
          </div>
        </div>

        <!-- Hero Preview Card -->
        <div id="preview" class="lg:col-span-5">
          <div class="bg-white rounded-2xl border border-pastel-accent/40 shadow-xl shadow-pastel-secondary/10 p-5 space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-pastel-surface/40">
              <span class="text-xs font-bold uppercase tracking-wider text-pastel-primary">Reading List</span>
              <span class="text-xs px-2.5 py-0.5 rounded-full bg-pastel-surface text-pastel-primary font-medium">1 Manga Aktif</span>
            </div>

            <div class="flex gap-4">
              <div class="w-24 h-32 rounded-xl bg-pastel-surface/40 border border-pastel-accent/30 overflow-hidden shrink-0 flex items-center justify-center text-xs text-slate-500 font-medium">
                Cover Manga
              </div>
              <div class="flex-1 flex flex-col justify-between py-1">
                <div>
                  <h3 class="font-bold text-base line-clamp-1">Sousou no Frieren</h3>
                  <p class="text-xs text-slate-500 mt-0.5">MangaDex · Ongoing</p>
                </div>
                <div class="space-y-2">
                  <div class="flex items-center justify-between text-xs">
                    <span class="text-slate-600">Progress</span>
                    <span class="font-bold text-pastel-primary">Ch. 130</span>
                  </div>
                  <div class="w-full bg-pastel-surface/40 h-2 rounded-full overflow-hidden">
                    <div class="bg-pastel-primary h-full rounded-full w-3/4"></div>
                  </div>
                </div>
              </div>
            </div>

            <div class="pt-2 flex gap-2">
              <button class="flex-1 py-2 text-xs font-semibold rounded-xl bg-pastel-canvas text-pastel-primary border border-pastel-accent/40 hover:bg-pastel-surface/50 transition-colors">
                +1 Chapter
              </button>
              <button class="px-3 py-2 text-xs font-semibold rounded-xl bg-pastel-surface/60 text-slate-700 hover:bg-pastel-surface transition-colors">
                Detail
              </button>
            </div>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
