---
import { UserButton } from "@clerk/astro/components";
import SearchModal from "../components/SearchModal";
import LibraryManager from "../components/LibraryManager";
import "../styles/global.css";

const { userId } = Astro.locals.auth();

if (!userId) {
  return Astro.redirect("/sign-in");
}
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Library Manga · MangaTrack</title>
  </head>
  <body class="bg-pastel-canvas text-[#1e1b4b] antialiased min-h-[100dvh] flex flex-col">
    <!-- Navbar -->
    <header class="w-full border-b border-pastel-accent/30 bg-white/80 backdrop-blur-md sticky top-0 z-40 transition-colors">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="w-8 h-8 rounded-xl bg-pastel-primary flex items-center justify-center text-white font-bold text-sm shadow-sm group-hover:bg-pastel-secondary transition-colors">
            M
          </div>
          <span class="font-bold text-base tracking-tight text-[#1e1b4b]">MangaTrack</span>
        </a>

        <div class="flex items-center gap-3">
          <a
            href="/"
            class="text-xs font-medium text-slate-600 hover:text-pastel-primary px-3 py-1.5 rounded-lg hover:bg-pastel-surface/40 transition-colors hidden sm:inline-block"
          >
            Beranda
          </a>
          <div class="h-4 w-px bg-pastel-accent/40 hidden sm:block"></div>
          <div class="flex items-center gap-2 pl-1">
            <UserButton afterSignOutUrl="/" />
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-6 sm:space-y-8">
      {/* Top Banner & Quick Action */}
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-2">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-pastel-primary">Koleksi Pribadi</span>
          <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight mt-0.5 text-[#1e1b4b]">
            Daftar Bacaan
          </h1>
          <p class="text-xs sm:text-sm text-slate-600 mt-1">
            Catat chapter terakhir dan atur status bacaan Anda.
          </p>
        </div>

        <div class="shrink-0">
          <SearchModal client:load />
        </div>
      </div>

      <!-- Library Grid & Manager Island -->
      <LibraryManager client:load />
    </main>

    <!-- Footer -->
    <footer class="w-full border-t border-pastel-accent/20 bg-white/40 py-6 mt-12 text-center text-xs text-slate-500">
      <div class="max-w-7xl mx-auto px-4">
        <span>MangaTrack · Data bersumber dari MangaDex API</span>
      </div>
    </footer>
  </body>
</html>
